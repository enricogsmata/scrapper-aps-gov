{
  "type": "module",
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "env": "^0.0.2",
    "mysql2": "^3.24.6",
    "pdf.js-extract": "^1.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11"
  },
  "scripts": {
    "raw:generate": "drizzle-kit generate --config=drizzle.raw.config.ts",
    "raw:migrate": "drizzle-kit migrate --config=drizzle.raw.config.ts",
    "raw:push": "drizzle-kit push --config=drizzle.raw.config.ts",
    "raw:update": "cls && npm run raw:push",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:update": "npm run db:generate && npm run db:migrate && npm run db:push",
    "rt": "npm run raw:update && cls && tsx ./src/transformer.ts",
    "git": "git add . && git commit -m ",
    "app": "cls && tsx ./src/index.ts"
  }
}
